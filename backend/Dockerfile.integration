FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.lock .
RUN pip install --no-cache-dir -r requirements.lock && useradd --create-home app
# The image reuses shared rules/parser. INSTALLED_APPS and PostgreSQL credentials
# enforce the service boundary, not source-code packaging alone.
COPY --chown=app:app . .
USER app
EXPOSE 8002
CMD ["python", "integration_service/manage.py", "runserver", "0.0.0.0:8002", "--noreload"]
