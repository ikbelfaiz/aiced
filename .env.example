# Local development only. Replace both placeholders before starting Compose.
DJANGO_SECRET_KEY=replace-with-a-random-secret-at-least-50-characters-long
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
POSTGRES_DB=aiced
POSTGRES_USER=aiced
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
LOGIN_WINDOW_SECONDS=900
LOGIN_ACCOUNT_LIMIT=10
LOGIN_IP_LIMIT=30
API_MAX_JSON_BYTES=65536
# Generate independently: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Same private key for gateway and backend; never send it to the browser.
AICED_GATEWAY_KEY=replace-with-an-independent-random-gateway-key
# Empty disables private RPC authentication. Configure only backend/private workers.
# Keep real per-service secrets in a private registry, never in frontend settings.
AICED_INTERNAL_KEYS={}
AUTH_LOCK_TIMEOUT_MS=5000
