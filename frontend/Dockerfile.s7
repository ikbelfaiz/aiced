FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build && mkdir -p /app/node_modules/.vite \
    && chown -R node:node /app/node_modules/.vite /app/node_modules/.vite-temp
USER node
EXPOSE 5173
CMD ["npm", "run", "preview", "--", "--config", "vite.s7.config.ts"]
